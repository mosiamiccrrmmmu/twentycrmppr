# ============================================
# PHARMED CRM 3.0.4 — تنظیمات محیط محلی
# این فایل را کپی کنید به .env و در صورت نیاز ویرایش کنید
# ============================================

ENVIRONMENT=production
DEBUG=false

# کلید امنیتی — حتماً قبل از استفاده واقعی عوض کنید (حداقل ۴۸ کاراکتر)
SECRET_KEY=pharmed-local-dev-secret-key-change-me-before-real-use-48chars-min

ACCESS_TOKEN_EXPIRE_MINUTES=45
DATABASE_URL=sqlite:///./data/farmed_crm.db

# برای اجرای لوکال این مقادیر کافی است
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1

DATA_DIR=./data
BACKUP_DIR=./backups
COMPANY_NAME=فارمد پلیمر رایان
DEFAULT_CURRENCY=تومان

# چهار کاربر اولیه (حداکثر ۴ کاربر مدیریت‌شده)
# بعد از اولین ورود حتماً رمزها را از داخل سیستم عوض کنید
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_BAYAT_PASSWORD=Bayat@12345
BOOTSTRAP_MOSTOFI_PASSWORD=Mostofi@12345
BOOTSTRAP_TAVAKOLI_PASSWORD=Tavakoli@12345
